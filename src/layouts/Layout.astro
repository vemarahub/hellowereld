```astro
---
interface Props {
        title?: string;
        description?: string;
}

const {
        title = "HelloWereld — Rajesh Nair",
        description = "Rajesh Nair — Software Engineer, MongoDB Champion, Author and Speaker.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
        <head>
                <meta charset="UTF-8" />
                <meta name="viewport" content="width=device-width" />
                <meta name="description" content={description} />
                <meta name="generator" content={Astro.generator} />
                <title>{title}</title>
        </head>

        <body>
                <header class="site-header">
                        <div class="header-inner">
                                <a href="/" class="logo">HelloWereld</a>

                                <nav>
                                        <a href="/writing">Writing</a>
                                        <a href="/tutorials">Tutorials</a>
                                        <a href="/mongodb">MongoDB</a>
                                        <a href="/projects">Projects</a>
                                        <a href="/talks">Talks</a>
                                        <a href="/about">About</a>
                                </nav>
                        </div>
                </header>

                <main>
                        <slot />
                </main>

                <footer class="site-footer">
                        <div class="footer-inner">
                                <span>© {new Date().getFullYear()} Rajesh Nair</span>
                                <span>HelloWereld</span>
                        </div>
                </footer>
        </body>
</html>

<style>
        :global(*) {
                box-sizing: border-box;
        }

        :global(html) {
                font-family:
                        Inter, ui-sans-serif, system-ui, -apple-system,
                        BlinkMacSystemFont, "Segoe UI", sans-serif;
                background: #ffffff;
                color: #171717;
        }

        :global(body) {
                margin: 0;
                min-width: 320px;
        }

        .site-header {
                border-bottom: 1px solid #e5e5e5;
                background: rgba(255, 255, 255, 0.95);
        }

        .header-inner,
        .footer-inner {
                max-width: 1100px;
                margin: 0 auto;
                padding: 1rem 1.5rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
        }

        .logo {
                color: #171717;
                text-decoration: none;
                font-weight: 700;
                font-size: 1.25rem;
        }

        nav {
                display: flex;
                gap: 1.25rem;
        }

        nav a {
                color: #525252;
                text-decoration: none;
                font-size: 0.95rem;
        }

        nav a:hover {
                color: #171717;
        }

        main {
                min-height: calc(100vh - 130px);
        }

        .site-footer {
                border-top: 1px solid #e5e5e5;
                color: #737373;
                font-size: 0.875rem;
        }

        @media (max-width: 700px) {
                nav {
                        display: none;
                }

                .header-inner {
                        padding: 1rem;
                }
        }
</style>
```