---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getRecentPosts, resolvePostLink, getFeaturedProjects } from "../lib/content";

const allPosts = await getCollection("writing");
const recentPosts = getRecentPosts(allPosts, 3);

const allProjects = await getCollection("projects");
const featuredProjects = getFeaturedProjects(allProjects, 3);
---

<Layout
  title="HelloWereld"
  description="Writing, projects, talks and experiments from the intersection of backend engineering, MongoDB and developer community."
>
  <section class="hero">
    <p class="eyebrow">HelloWereld</p>

    <h1>Building software,<br />exploring what's next.</h1>

    <p class="description">
      A home for writing, projects, talks and experiments — from the
      intersection of backend engineering, databases and the developer
      community.
    </p>

    <div class="links">
      <a href="/about">About this site →</a>
      <a href="/writing">Read the writing →</a>
    </div>
  </section>

  <section class="areas" aria-label="Areas of focus">
    <article class="area-card">
      <h2>Engineering</h2>
      <p>
        Backend engineering, Java, Node.js, AWS, distributed systems
        and cloud architecture.
      </p>
    </article>

    <article class="area-card">
      <h2>Databases</h2>
      <p>
        Databases, MongoDB, distributed data, schema design and data engineering.
      </p>
    </article>

    <article class="area-card">
      <h2>Sharing</h2>
      <p>
        Tutorials, articles, talks, videos and experiments from a
        journey in technology.
      </p>
    </article>
  </section>

  <section class="recent-writing" aria-label="Recent writing">
    <div class="section-inner">
      <header class="section-header">
        <p class="section-eyebrow">Recent Writing</p>
        <h2>Writing</h2>
      </header>

      <div class="post-list">
        {
          recentPosts.map((post) => {
            const { href, isExternal } = resolvePostLink(post);
            return (
              <article class="post-item">
                <div class="post-meta">
                  {post.data.date.toLocaleDateString("en-GB", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </div>

                <h3 class="post-title">
                  <a
                    href={href}
                    {...isExternal
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {}}
                  >
                    {post.data.title}
                    {isExternal && <span aria-hidden="true"> ↗</span>}
                  </a>
                </h3>

                <p class="post-description">{post.data.description}</p>

                {post.data.tags.length > 0 && (
                  <div class="post-tags">
                    {post.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
              </article>
            );
          })
        }
      </div>

      <footer class="section-footer">
        <a href="/writing">View all writing →</a>
      </footer>
    </div>
  </section>

  <section class="featured-projects" aria-label="Featured projects">
    <div class="section-inner">
      <header class="section-header">
        <p class="section-eyebrow">Featured Projects</p>
        <h2>Projects</h2>
      </header>

      <div class="project-grid">
        {
          featuredProjects.map((project) => (
            <article class="project-card">
              <div class="project-card-header">
                <h3 class="project-title">{project.data.title}</h3>
                <span class={`badge badge-${project.data.status}`}>
                  {project.data.status}
                </span>
              </div>

              <p class="project-description">{project.data.description}</p>

              {project.data.technologies.length > 0 && (
                <div class="project-tags">
                  {project.data.technologies.map((tech) => (
                    <span class="tag">{tech}</span>
                  ))}
                </div>
              )}

              {project.data.github && (
                <div class="project-links">
                  <a
                    href={project.data.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-link"
                  >
                    GitHub ↗
                  </a>
                </div>
              )}
            </article>
          ))
        }
      </div>

      <footer class="section-footer">
        <a href="/projects">View all projects →</a>
      </footer>
    </div>
  </section>

  <section class="cta" aria-label="Find out more">
    <div class="cta-inner">
      <h2 class="cta-heading">Want to know more?</h2>
      <p class="cta-body">The full story is on the About page.</p>
      <a class="cta-link" href="/about">About this site →</a>
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero ---- */
  .hero {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: 7rem var(--space-6) 5rem;
  }

  .eyebrow {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tighter);
  }

  .description {
    max-width: 620px;
    margin: var(--space-6) 0 0;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .links a {
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    font-size: var(--text-base);
    transition: opacity var(--transition-fast);
  }

  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- Area cards ---- */
  .areas {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-24);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .area-card {
    padding: var(--space-6) var(--space-6) var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition: border-color var(--transition-base);
  }

  .area-card:hover {
    border-color: var(--color-border-strong);
  }

  .area-card h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }

  .area-card p {
    margin: 0;
    line-height: var(--leading-normal);
    color: var(--color-muted);
    font-size: var(--text-base);
  }

  /* ---- Responsive ---- */
  @media (max-width: 700px) {
    .hero {
      padding-top: 4rem;
      padding-bottom: 3rem;
    }

    .areas {
      grid-template-columns: 1fr;
      padding-bottom: var(--space-16);
    }

    .links {
      flex-direction: column;
      gap: var(--space-4);
    }
  }

  /* ---- Recent Writing ---- */
  .recent-writing {
    padding: 0 var(--space-6) var(--space-24);
  }

  .section-inner {
    max-width: var(--container-md);
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: var(--space-8);
  }

  .section-eyebrow {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .section-header h2 {
    margin: 0;
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .post-list {
    border-top: 1px solid var(--color-border);
  }

  .post-item {
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-meta {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .post-title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }

  .post-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .post-title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-description {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-secondary);
    max-width: 640px;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .tag {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    color: var(--color-secondary);
  }

  .section-footer {
    margin-top: var(--space-8);
  }

  .section-footer a {
    color: var(--color-text);
    font-weight: 600;
    font-size: var(--text-base);
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .section-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 700px) {
    .recent-writing {
      padding-bottom: var(--space-16);
    }
  }

  /* ---- Badge ---- */
  .badge {
    display: inline-block;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    padding: 0.2rem 0.6rem;
    font-weight: 600;
    text-transform: capitalize;
    white-space: nowrap;
  }

  .badge-active {
    background: var(--color-accent-subtle);
    color: var(--color-accent-dark);
  }

  .badge-completed {
    background: var(--color-border);
    color: var(--color-secondary);
  }

  .badge-experiment {
    background: var(--color-bg);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
  }

  /* ---- Featured Projects ---- */
  .featured-projects {
    padding: 0 var(--space-6) var(--space-24);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .project-card {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color var(--transition-base);
  }

  .project-card:hover {
    border-color: var(--color-border-strong);
  }

  .project-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .project-title {
    margin: 0;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    line-height: var(--leading-snug);
  }

  .project-description {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-secondary);
    flex: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-links {
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .project-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .project-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 700px) {
    .featured-projects {
      padding-bottom: var(--space-16);
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- CTA ---- */
  .cta {
    border-top: 1px solid var(--color-border);
    padding: var(--space-16) var(--space-6) var(--space-24);
  }

  .cta-inner {
    max-width: var(--container-md);
    margin: 0 auto;
  }

  .cta-heading {
    margin: 0 0 var(--space-3);
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .cta-body {
    margin: 0 0 var(--space-8);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary);
  }

  .cta-link {
    color: var(--color-text);
    font-weight: 600;
    font-size: var(--text-base);
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .cta-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 700px) {
    .cta {
      padding-bottom: var(--space-16);
    }
  }
</style>
