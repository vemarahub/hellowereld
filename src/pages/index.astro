```astro
---
import Layout from "../layouts/Layout.astro";
---

<Layout>
        <section class="hero">
                <p class="eyebrow">HelloWereld</p>

                <h1>Rajesh Nair</h1>

                <p class="intro">
                        Software Engineer · MongoDB Champion · Author · Speaker
                </p>

                <p class="description">
                        I build backend systems, explore databases and cloud
                        technologies, and share what I learn through writing,
                        talks, videos and open-source projects.
                </p>

                <div class="links">
                        <a href="/about">About me →</a>
                        <a href="/writing">Read my writing →</a>
                </div>
        </section>

        <section class="areas">
                <article>
                        <h2>Engineering</h2>
                        <p>
                                Backend engineering, Java, Node.js, AWS,
                                distributed systems and cloud architecture.
                        </p>
                </article>

                <article>
                        <h2>MongoDB</h2>
                        <p>
                                MongoDB Champion, community contributor,
                                speaker and author.
                        </p>
                </article>

                <article>
                        <h2>Sharing</h2>
                        <p>
                                Tutorials, articles, talks, videos and
                                experiments from my journey in technology.
                        </p>
                </article>
        </section>
</Layout>

<style>
        .hero {
                max-width: 900px;
                margin: 0 auto;
                padding: 7rem 1.5rem 5rem;
        }

        .eyebrow {
                margin: 0 0 1rem;
                font-size: 0.9rem;
                font-weight: 600;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: #737373;
        }

        h1 {
                margin: 0;
                font-size: clamp(3.5rem, 9vw, 6.5rem);
                line-height: 0.95;
                letter-spacing: -0.06em;
        }

        .intro {
                margin: 2rem 0 0;
                font-size: clamp(1.25rem, 3vw, 1.75rem);
                color: #404040;
        }

        .description {
                max-width: 680px;
                margin: 1.5rem 0 0;
                font-size: 1.1rem;
                line-height: 1.7;
                color: #737373;
        }

        .links {
                display: flex;
                gap: 1.5rem;
                margin-top: 2rem;
        }

        .links a {
                color: #171717;
                font-weight: 600;
                text-decoration: none;
        }

        .links a:hover {
                text-decoration: underline;
        }

        .areas {
                max-width: 1100px;
                margin: 0 auto;
                padding: 0 1.5rem 6rem;
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 1.5rem;
        }

        .areas article {
                padding: 1.75rem;
                border: 1px solid #e5e5e5;
                border-radius: 12px;
        }

        .areas h2 {
                margin: 0 0 0.75rem;
                font-size: 1.2rem;
        }

        .areas p {
                margin: 0;
                line-height: 1.6;
                color: #737373;
        }

        @media (max-width: 700px) {
                .hero {
                        padding-top: 4rem;
                }

                .areas {
                        grid-template-columns: 1fr;
                }

                .links {
                        flex-direction: column;
                        gap: 0.75rem;
                }
        }
</style>
```