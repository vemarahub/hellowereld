---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("writing");

	return posts.map((post) => ({
		params: {
			slug: post.id,
		},
		props: {
			post,
		},
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
	title={`${post.data.title} — HelloWereld`}
	description={post.data.description}
>
	<article class="article">
		<header>
			<a href="/writing" class="back">← Back to writing</a>

			<p class="date">
				{post.data.date.toLocaleDateString("en-GB", {
					year: "numeric",
					month: "long",
					day: "numeric",
				})}
			</p>

			<h1>{post.data.title}</h1>

			<p class="description">{post.data.description}</p>

			{post.data.tags.length > 0 && (
				<div class="tags">
					{post.data.tags.map((tag) => <span>{tag}</span>)}
				</div>
			)}
		</header>

		{post.data.externalUrl ? (
			<div class="external-notice">
				<p>This article was originally published externally.</p>
				<a
					href={post.data.externalUrl}
					target="_blank"
					rel="noopener noreferrer"
				>Read the original article ↗</a>
			</div>
		) : (
			<div class="content">
				<Content />
			</div>
		)}
	</article>
</Layout>

<style>
	.article {
		max-width: 760px;
		margin: 0 auto;
		padding: 4rem 1.5rem 6rem;
	}

	.back {
		display: inline-block;
		margin-bottom: var(--space-12);
		color: var(--color-muted);
		text-decoration: none;
		font-size: var(--text-sm);
	}

	.back:hover {
		color: var(--color-text);
	}

	header {
		margin-bottom: 3rem;
	}

	.date {
		margin: 0 0 var(--space-4);
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	h1 {
		margin: 0 0 1rem;
		font-size: clamp(2.5rem, 7vw, 4.5rem);
		line-height: 1.05;
		letter-spacing: -0.04em;
	}

	.description {
		margin: 0;
		font-size: var(--text-xl);
		line-height: var(--leading-relaxed);
		color: var(--color-secondary);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.5rem;
	}

	.tags span {
		padding: 0.35rem 0.65rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		color: var(--color-secondary);
	}

	.content {
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.content :global(h2) {
		margin-top: 3rem;
		font-size: 1.8rem;
	}

	.content :global(h3) {
		margin-top: 2rem;
		font-size: 1.4rem;
	}

	.content :global(p) {
		margin: 1.25rem 0;
	}

	.content :global(a) {
		color: inherit;
	}

	.content :global(ul),
	.content :global(ol) {
		padding-left: 1.5rem;
	}

	.content :global(code) {
		padding: 0.15rem 0.35rem;
		background: var(--color-bg);
		border-radius: var(--radius-sm);
		font-size: 0.9em;
	}

	.content :global(pre) {
		padding: var(--space-5);
		overflow-x: auto;
		background: var(--color-bg);
		border-radius: var(--radius-md);
	}

	.external-notice {
		margin-top: var(--space-8);
		padding: var(--space-6);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-bg);
		font-size: var(--text-base);
		line-height: var(--leading-normal);
	}

	.external-notice p {
		margin: 0 0 var(--space-4);
		color: var(--color-secondary);
	}

	.external-notice a {
		color: var(--color-text);
		font-weight: 500;
	}

	.external-notice a:hover {
		color: var(--color-muted);
	}
</style>