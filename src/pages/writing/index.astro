---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { resolvePostLink } from '../../lib/content';

const allPosts = await getCollection('writing');

// ── Topic metadata ─────────────────────────────────────────────────────────
const TOPICS: Record<string, {
  color: string;
  bg: string;
  logo: string;
  description: string;
}> = {
  'MongoDB': {
    color: '#00ED64',
    bg: '#F0FDF4',
    description: 'NoSQL database design, operations, replication, and sharding.',
    logo: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M16 2C16 2 10 10.5 10 18a6 6 0 0 0 5.25 5.94V30h1.5v-6.06A6 6 0 0 0 22 18C22 10.5 16 2 16 2Z" fill="#00ED64"/>
      <path d="M16 22.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5Z" fill="#001E2B"/>
    </svg>`,
  },
  'MySQL': {
    color: '#4479A1',
    bg: '#EFF6FF',
    description: 'MySQL architecture, configuration, replication, and performance tuning.',
    logo: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <ellipse cx="16" cy="10" rx="12" ry="3" fill="#4479A1"/>
      <path d="M4 10v4c0 1.66 5.37 3 12 3s12-1.34 12-3v-4" stroke="#4479A1" stroke-width="1.5" fill="none"/>
      <path d="M4 14v4c0 1.66 5.37 3 12 3s12-1.34 12-3v-4" stroke="#4479A1" stroke-width="1.5" fill="none"/>
      <path d="M4 18v4c0 1.66 5.37 3 12 3s12-1.34 12-3v-4" stroke="#4479A1" stroke-width="1.5" fill="none"/>
    </svg>`,
  },
  'Progress/OpenEdge': {
    color: '#E97E2E',
    bg: '#FFF7ED',
    description: 'Progress OpenEdge DBA essentials — architecture, administration, and scripting.',
    logo: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <rect x="4" y="4" width="24" height="24" rx="5" fill="#E97E2E" opacity=".15"/>
      <text x="7" y="23" font-family="monospace" font-size="14" font-weight="700" fill="#E97E2E">OE</text>
    </svg>`,
  },
  'Shell Scripting': {
    color: '#3D9970',
    bg: '#F0FDF4',
    description: 'Practical shell scripts for automation, database ops, and system administration.',
    logo: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <rect x="3" y="5" width="26" height="22" rx="4" fill="#171717"/>
      <path d="M9 13l5 3.5L9 20" stroke="#3D9970" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M16 20h7" stroke="#3D9970" stroke-width="2" stroke-linecap="round"/>
    </svg>`,
  },
  'Linux': {
    color: '#D4A017',
    bg: '#FEFCE8',
    description: 'Linux system administration, environment setup, and essential commands.',
    logo: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M16 3c-3 0-5.5 2-6.5 5-.5 1.5-.5 3 0 4.5C8 14 7 16 7 18c0 3 2 5 4 6l1 3h8l1-3c2-1 4-3 4-6 0-2-1-4-2.5-5.5.5-1.5.5-3 0-4.5C21.5 5 19 3 16 3Z" fill="#FCC624" opacity=".9"/>
      <circle cx="13" cy="14" r="1.5" fill="#171717"/>
      <circle cx="19" cy="14" r="1.5" fill="#171717"/>
      <path d="M13 18s1 2 3 2 3-2 3-2" stroke="#171717" stroke-width="1.5" stroke-linecap="round"/>
    </svg>`,
  },
  'Angular': {
    color: '#DD0031',
    bg: '#FFF1F2',
    description: 'Angular framework — components, routing, services, and UI integration.',
    logo: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M16 3 4 7.5l1.8 15.7L16 29l10.2-5.8L28 7.5 16 3Z" fill="#DD0031"/>
      <path d="M11 21l2.2-5.5h5.6L21 21M12.8 17h6.4" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`,
  },
  'AWS': {
    color: '#FF9900',
    bg: '#FFFBEB',
    description: 'Amazon Web Services — cloud fundamentals and key services.',
    logo: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M10 19c-2.8-.7-5-2.7-5-5.5C5 10 7.7 8 11 8c.4 0 .8 0 1.2.1C13.2 6.2 15 5 17.5 5 21 5 24 7.7 24 11c0 .3 0 .7-.1 1C25.7 12.5 27 14 27 16c0 2.5-2 4-4.5 4H10Z" fill="#FF9900" opacity=".85"/>
      <path d="M10 24l3-2 3 2 3-2 3 2" stroke="#FF9900" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`,
  },
  'General': {
    color: '#737373',
    bg: '#F5F5F5',
    description: 'Miscellaneous technical notes and articles.',
    logo: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <rect x="6" y="5" width="20" height="24" rx="3" fill="#E5E5E5"/>
      <path d="M10 11h12M10 15h12M10 19h8" stroke="#737373" stroke-width="1.8" stroke-linecap="round"/>
    </svg>`,
  },
};

const TOPIC_ORDER = [
  'MongoDB', 'MySQL', 'Progress/OpenEdge', 'Shell Scripting',
  'Linux', 'Angular', 'AWS', 'General',
];

// ── Group & sort ───────────────────────────────────────────────────────────
const postsByTopic = new Map<string, typeof allPosts>();
for (const post of allPosts) {
  const topic = post.data.topic || 'General';
  if (!postsByTopic.has(topic)) postsByTopic.set(topic, []);
  postsByTopic.get(topic)!.push(post);
}
for (const posts of postsByTopic.values()) {
  posts.sort((a, b) => {
    const d = (a.data.order ?? 999) - (b.data.order ?? 999);
    return d !== 0 ? d : a.data.title.localeCompare(b.data.title);
  });
}
const sortedTopics = TOPIC_ORDER.filter(t => postsByTopic.has(t));

// ── Stats ──────────────────────────────────────────────────────────────────
const totalPosts  = allPosts.length;
const totalTopics = sortedTopics.length;

// ── Read-time estimate ─────────────────────────────────────────────────────
function readTime(post: (typeof allPosts)[0]): number {
  const words = (post.body ?? '').trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
}

// ── Build flat search index (serialised for client) ───────────────────────
const searchIndex = allPosts.map(post => ({
  slug:   post.slug ?? post.id.replace(/\.md$/, ''),
  title:  post.data.title,
  desc:   post.data.description ?? '',
  topic:  post.data.topic ?? 'General',
}));
---

<Layout title="Logbook — Rajesh Nair" description="Technical deep-dives and practical notes from 15+ years of engineering.">

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Logbook</p>
      <h1>Things I've learned<br/>along the way.</h1>
      <p class="hero-sub">
        Technical deep-dives and practical notes from 15+ years working with
        databases, infrastructure, and software engineering.
      </p>
      <div class="hero-stats" role="list" aria-label="Logbook statistics">
        <div class="stat" role="listitem">
          <span class="stat-number">{totalPosts}</span>
          <span class="stat-label">Entries</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat" role="listitem">
          <span class="stat-number">{totalTopics}</span>
          <span class="stat-label">Topics</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat" role="listitem">
          <span class="stat-number">15+</span>
          <span class="stat-label">Years</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Search bar ────────────────────────────────────────────────────── -->
  <div class="search-bar-wrap">
    <div class="search-bar-inner">
      <label for="logbook-search" class="sr-only">Search entries</label>
      <div class="search-input-wrap">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <circle cx="7.5" cy="7.5" r="5" stroke="currentColor" stroke-width="1.6"/>
          <path d="M11.5 11.5L15.5 15.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <input
          id="logbook-search"
          type="search"
          placeholder="Search entries…"
          autocomplete="off"
          spellcheck="false"
          aria-label="Search logbook entries"
        />
        <button class="search-clear" id="search-clear" aria-label="Clear search" hidden>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      <p class="search-results-label" id="search-status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </div>

  <!-- ── Sticky topic nav ──────────────────────────────────────────────── -->
  <nav class="topic-nav" aria-label="Jump to topic" id="topic-nav">
    <div class="topic-nav-inner">
      {sortedTopics.map(topic => {
        const meta = TOPICS[topic] ?? TOPICS['General'];
        const slug = topic.toLowerCase().replace(/[^a-z0-9]+/g, '-');
        return (
          <a href={`#${slug}`} class="topic-pill" style={`--pill-color:${meta.color}`} data-topic={topic}>
            <span class="pill-logo" set:html={meta.logo} />
            <span class="pill-label">{topic}</span>
            <span class="pill-count" data-topic-count={topic}>{postsByTopic.get(topic)!.length}</span>
          </a>
        );
      })}
    </div>
  </nav>

  <!-- ── View toggle ───────────────────────────────────────────────────── -->
  <div class="view-toolbar" role="toolbar" aria-label="View options">
    <div class="view-toolbar-inner">
      <span class="toolbar-label">View</span>
      <div class="toggle-group" role="radiogroup" aria-label="Layout">
        <button class="toggle-btn is-active" id="view-list" role="radio" aria-checked="true" aria-label="List view" data-view="list">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          List
        </button>
        <button class="toggle-btn" id="view-grid" role="radio" aria-checked="false" aria-label="Grid view" data-view="grid">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="2" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
            <rect x="9" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
            <rect x="2" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
            <rect x="9" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          Grid
        </button>
      </div>
    </div>
  </div>

  <!-- ── Search empty state ────────────────────────────────────────────── -->
  <div class="search-empty" id="search-empty" hidden>
    <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
      <circle cx="17" cy="17" r="11" stroke="#D4D4D4" stroke-width="2"/>
      <path d="M26 26L34 34" stroke="#D4D4D4" stroke-width="2" stroke-linecap="round"/>
      <path d="M13 17h8M17 13v8" stroke="#D4D4D4" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <p>No entries match <strong id="search-query-label"></strong></p>
    <button class="clear-btn" id="search-empty-clear">Clear search</button>
  </div>

  <!-- ── Topic sections ────────────────────────────────────────────────── -->
  <main id="main-content" class="content">
    {sortedTopics.map(topic => {
      const posts = postsByTopic.get(topic)!;
      const meta  = TOPICS[topic] ?? TOPICS['General'];
      const slug  = topic.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      return (
        <section
          class="topic-section"
          id={slug}
          data-topic={topic}
          style={`--topic-color:${meta.color};--topic-bg:${meta.bg}`}
        >
          <header class="topic-header reveal">
            <div class="topic-icon" aria-hidden="true" set:html={meta.logo} />
            <div class="topic-meta">
              <h2 class="topic-name">{topic}</h2>
              <p class="topic-desc">{meta.description}</p>
            </div>
            <span class="topic-badge" data-topic-badge={topic}>{posts.length} entries</span>
          </header>

          <ol class="posts-grid" aria-label={`${topic} entries`}>
            {posts.map((post, idx) => {
              const { href, isExternal } = resolvePostLink(post);
              const mins = readTime(post);
              return (
                <li
                  class="card-wrap reveal"
                  style={`--i:${idx}`}
                  data-title={post.data.title.toLowerCase()}
                  data-desc={(post.data.description ?? '').toLowerCase()}
                  data-topic={topic.toLowerCase()}
                >
                  <a
                    href={href}
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noopener noreferrer' : undefined}
                    class="card"
                  >
                    <span class="card-num" aria-hidden="true">
                      {String(idx + 1).padStart(2, '0')}
                    </span>
                    <span class="card-body">
                      <span class="card-title">{post.data.title}{isExternal && <span class="ext-icon" aria-label="(external)">↗</span>}</span>
                      {post.data.description && (
                        <span class="card-desc">{post.data.description}</span>
                      )}
                      <span class="card-meta">
                        <span class="read-time">{mins} min read</span>
                      </span>
                    </span>
                    <span class="card-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      );
    })}
  </main>

</Layout>

<script>
  // ── Search index injected from server ──────────────────────────────────
  // All filtering is done against data-* attrs on the DOM (no JS bundle bloat)

  const input      = document.getElementById('logbook-search')    as HTMLInputElement;
  const clearBtn   = document.getElementById('search-clear')      as HTMLButtonElement;
  const emptyState = document.getElementById('search-empty')      as HTMLElement;
  const emptyLabel = document.getElementById('search-query-label')as HTMLElement;
  const emptyClear = document.getElementById('search-empty-clear') as HTMLButtonElement;
  const statusEl   = document.getElementById('search-status')     as HTMLElement;
  const topicNav   = document.getElementById('topic-nav')         as HTMLElement;

  const allCards    = document.querySelectorAll<HTMLElement>('.card-wrap');
  const allSections = document.querySelectorAll<HTMLElement>('.topic-section');

  function runSearch(query: string) {
    const q = query.trim().toLowerCase();
    clearBtn.hidden = q.length === 0;

    if (q.length === 0) {
      // Reset — show everything
      allCards.forEach(c => c.hidden = false);
      allSections.forEach(s => {
        s.hidden = false;
        // restore badge counts
        const badge = s.querySelector<HTMLElement>('[data-topic-badge]');
        const cards = s.querySelectorAll<HTMLElement>('.card-wrap');
        if (badge) badge.textContent = `${cards.length} entries`;
      });
      emptyState.hidden = true;
      statusEl.textContent = '';
      topicNav.style.display = '';
      return;
    }

    let totalVisible = 0;

    allSections.forEach(section => {
      const cards   = section.querySelectorAll<HTMLElement>('.card-wrap');
      const badge   = section.querySelector<HTMLElement>('[data-topic-badge]');
      let sectionVisible = 0;

      cards.forEach(card => {
        const title = card.dataset.title ?? '';
        const desc  = card.dataset.desc  ?? '';
        const topic = card.dataset.topic ?? '';
        const match = title.includes(q) || desc.includes(q) || topic.includes(q);
        card.hidden = !match;
        if (match) sectionVisible++;
      });

      section.hidden = sectionVisible === 0;
      if (badge) badge.textContent = `${sectionVisible} entries`;
      totalVisible += sectionVisible;
    });

    topicNav.style.display = 'none'; // hide topic nav during search
    emptyState.hidden = totalVisible > 0;
    emptyLabel.textContent = `"${query.trim()}"`;
    statusEl.textContent = totalVisible > 0
      ? `${totalVisible} entr${totalVisible === 1 ? 'y' : 'ies'} found`
      : '';
  }

  // Debounce for performance on 111 cards
  let debounceTimer: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => runSearch(input.value), 160);
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    runSearch('');
    input.focus();
  });

  emptyClear.addEventListener('click', () => {
    input.value = '';
    runSearch('');
    input.focus();
  });

  // ── View toggle (list / grid) ──────────────────────────────────────────
  const toggleBtns = document.querySelectorAll<HTMLButtonElement>('.toggle-btn');
  const grids      = document.querySelectorAll<HTMLElement>('.posts-grid');

  toggleBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const view = btn.dataset.view!;
      toggleBtns.forEach(b => {
        b.classList.toggle('is-active', b === btn);
        b.setAttribute('aria-checked', b === btn ? 'true' : 'false');
      });
      grids.forEach(g => g.setAttribute('data-view', view));
      try { localStorage.setItem('hw-logbook-view', view); } catch {}
    });
  });

  try {
    if (localStorage.getItem('hw-logbook-view') === 'grid') {
      document.getElementById('view-grid')?.click();
    }
  } catch {}

  // ── Sticky topic-nav active highlight on scroll ────────────────────────
  const pills    = document.querySelectorAll<HTMLAnchorElement>('.topic-pill');
  const sections = document.querySelectorAll<HTMLElement>('.topic-section');

  const navIO = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        pills.forEach(p => p.classList.toggle('is-active', p.getAttribute('href') === `#${id}`));
      }
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  sections.forEach(s => navIO.observe(s));

  // ── Reveal on scroll ──────────────────────────────────────────────────
  const revealIO = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        (entry.target as HTMLElement).classList.add('is-visible');
        revealIO.unobserve(entry.target);
      }
    });
  }, { rootMargin: '0px 0px -60px 0px', threshold: 0.05 });
  document.querySelectorAll('.reveal').forEach(el => revealIO.observe(el));
</script>

<style>
  /* ── Utilities ───────────────────────────────────────────────────────── */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Hero ────────────────────────────────────────────────────────────── */
  .hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-20) var(--space-6) var(--space-16);
  }
  .hero-inner {
    max-width: var(--container-lg);
    margin: 0 auto;
  }
  .eyebrow {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-accent-dark);
  }
  .hero h1 {
    margin: 0 0 var(--space-5);
    font-size: clamp(2.2rem, 5.5vw, 3.8rem);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }
  .hero-sub {
    margin: 0 0 var(--space-10);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-secondary);
    max-width: 58ch;
  }
  .hero-stats {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .stat { display: flex; flex-direction: column; gap: 2px; }
  .stat-number {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    line-height: 1;
  }
  .stat-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
    font-weight: 600;
  }
  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--color-border);
    flex-shrink: 0;
  }

  /* ── Search bar ──────────────────────────────────────────────────────── */
  .search-bar-wrap {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) var(--space-6);
  }
  .search-bar-inner {
    max-width: var(--container-lg);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .search-input-wrap {
    position: relative;
    flex: 1;
    min-width: 220px;
    max-width: 480px;
  }
  .search-icon {
    position: absolute;
    left: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-muted);
    pointer-events: none;
  }
  #logbook-search {
    width: 100%;
    padding: var(--space-2) var(--space-8) var(--space-2) 2.5rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    /* iOS tap-highlight & font fix */
    -webkit-tap-highlight-color: transparent;
    -webkit-appearance: none;
  }
  #logbook-search:focus {
    border-color: var(--color-accent-dark);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }
  #logbook-search::placeholder { color: var(--color-muted); }
  /* hide browser clear button — we have our own */
  #logbook-search::-webkit-search-cancel-button { display: none; }

  .search-clear {
    position: absolute;
    right: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    padding: var(--space-1);
    color: var(--color-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
