---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { resolvePostLink } from "../../lib/content";

const posts = await getCollection("writing");

const sortedPosts = posts.sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
	title="Writing — Rajesh Nair"
	description="Articles, tutorials and technical writing by Rajesh Nair."
>
	<section class="page">
		<header class="intro">
			<p class="eyebrow">Writing</p>
			<h1>Things I've learned along the way.</h1>
			<p>
				Technical articles, tutorials and notes from building software,
				working with databases and exploring new technologies.
			</p>
		</header>

		<div class="posts">
			{
				sortedPosts.length === 0 ? (
					<p class="empty">No articles published yet.</p>
				) : (
					sortedPosts.map((post) => {
						const { href, isExternal } = resolvePostLink(post);
						return (
							<article class="post">
								<div class="meta">
									{post.data.date.toLocaleDateString("en-GB", {
										year: "numeric",
										month: "short",
										day: "numeric",
									})}
								</div>

								<h2>
									{isExternal ? (
										<a
											href={href}
											target="_blank"
											rel="noopener noreferrer"
										>
											{post.data.title}<span aria-hidden="true"> ↗</span>
										</a>
									) : (
										<a href={href}>{post.data.title}</a>
									)}
								</h2>

								<p>{post.data.description}</p>

								{post.data.tags.length > 0 && (
									<div class="tags">
										{post.data.tags.map((tag) => (
											<span>{tag}</span>
										))}
									</div>
								)}
							</article>
						);
					})
				)
			}
		</div>
	</section>
</Layout>

<style>
	.page {
		max-width: var(--container-lg);
		margin: 0 auto;
		padding: var(--space-20) var(--space-6);
	}

	.intro {
		max-width: 700px;
		margin-bottom: var(--space-16);
	}

	.eyebrow {
		margin: 0 0 var(--space-3);
		font-size: var(--text-sm);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-muted);
	}

	h1 {
		margin: 0 0 var(--space-4);
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
	}

	.intro > p:last-child {
		margin: 0;
		font-size: var(--text-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-secondary);
	}

	.posts {
		display: grid;
		gap: 0;
		border-top: 1px solid var(--color-border);
	}

	.post {
		padding: var(--space-8) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.meta {
		margin-bottom: var(--space-3);
		font-size: var(--text-sm);
		color: var(--color-muted);
	}

	h2 {
		margin: 0 0 var(--space-3);
		font-size: var(--text-2xl);
	}

	h2 a {
		color: var(--color-text);
		text-decoration: none;
	}

	h2 a:hover {
		color: var(--color-accent-dark);
	}

	h2 a:focus-visible {
		outline: 2px solid var(--color-accent-dark);
		outline-offset: 2px;
		border-radius: var(--radius-sm);
	}

	.post p {
		margin: 0;
		max-width: 700px;
		line-height: var(--leading-relaxed);
		color: var(--color-secondary);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}

	.tags span {
		padding: 0.35rem 0.65rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		color: var(--color-secondary);
	}

	.empty {
		padding: var(--space-12) 0;
		color: var(--color-muted);
		font-size: var(--text-lg);
	}
</style>
