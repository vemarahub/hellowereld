---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { resolvePostLink } from '../../lib/content';

const allPosts = await getCollection('writing');

// Group by topic, sort within each topic by order then title
const TOPIC_ORDER = [
  'MongoDB',
  'MySQL',
  'Progress/OpenEdge',
  'Shell Scripting',
  'Linux',
  'Angular',
  'AWS',
  'General',  // catch-all for uncategorized
];

const postsByTopic = new Map<string, typeof allPosts>();

for (const post of allPosts) {
  const topic = post.data.topic || 'General';
  if (!postsByTopic.has(topic)) postsByTopic.set(topic, []);
  postsByTopic.get(topic)!.push(post);
}

// Sort posts within each topic by order ascending, then title
for (const [topic, posts] of postsByTopic) {
  posts.sort((a, b) => {
    const orderDiff = (a.data.order ?? 999) - (b.data.order ?? 999);
    return orderDiff !== 0 ? orderDiff : a.data.title.localeCompare(b.data.title);
  });
}

// Order topics by TOPIC_ORDER
const sortedTopics = TOPIC_ORDER.filter(t => postsByTopic.has(t));
---

<Layout title="Writing — Rajesh Nair" description="Technical articles grouped by topic">
  <div class="container">
    <header class="page-header">
      <h1>Writing</h1>
      <p>Technical articles, tutorials, and notes organized by topic.</p>
    </header>

    {sortedTopics.length === 0 ? (
      <p class="empty">No articles published yet.</p>
    ) : (
      sortedTopics.map(topic => {
        const posts = postsByTopic.get(topic)!;
        return (
          <section class="topic-section">
            <h2 class="topic-heading">{topic}</h2>
            <ol class="post-list">
              {posts.map(post => {
                const { href, isExternal } = resolvePostLink(post);
                return (
                  <li>
                    <a
                      href={href}
                      target={isExternal ? '_blank' : undefined}
                      rel={isExternal ? 'noopener noreferrer' : undefined}
                      class="post-link"
                    >
                      <span class="post-title">
                        {post.data.title}
                        {isExternal && <span class="external-indicator" aria-hidden="true">↗</span>}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </section>
        );
      })
    )}
  </div>
</Layout>

<style>
  .container {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: var(--space-12) var(--space-4);
  }

  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-header h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .page-header p {
    font-size: var(--text-lg);
    color: var(--color-secondary);
    max-width: 60ch;
  }

  .topic-section {
    margin-bottom: var(--space-12);
  }

  .topic-heading {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .post-list {
    list-style: decimal-leading-zero;
    padding-left: var(--space-6);
    display: grid;
    gap: var(--space-4);
  }

  .post-list li {
    line-height: 1.6;
  }

  .post-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .post-link:hover {
    color: var(--color-accent);
  }

  .post-title {
    font-size: var(--text-base);
  }

  .external-indicator {
    margin-left: var(--space-1);
    font-size: 0.85em;
    vertical-align: super;
  }

  .empty {
    color: var(--color-muted);
    font-style: italic;
    padding: var(--space-8);
    text-align: center;
  }

  @media (max-width: 700px) {
    .page-header h1 {
      font-size: var(--text-2xl);
    }

    .topic-heading {
      font-size: var(--text-lg);
    }
  }
</style>
