---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { sortProjectsPage } from "../lib/content";

const allProjects = await getCollection("projects");
const sorted = sortProjectsPage(allProjects);
---

<Layout
	title="The Lab — HelloWereld"
	description="Software projects and experiments."
>
	<section class="page">
		<header class="intro">
			<p class="eyebrow">The Lab</p>
			<h1>The Lab</h1>
			<p>
				A curated collection of software work — from production tools to
				side experiments. Each project represents something built, shipped
				or learned along the way.
			</p>
		</header>

		<div class="project-list">
			{
				sorted.length === 0 ? (
					<p class="empty">No projects listed yet.</p>
				) : (
					sorted.map((project) => (
						<article class="project-card">
							<div class="card-header">
								<h2>{project.data.title}</h2>
								<span
									class:list={[
										"badge",
										`badge-${project.data.status}`,
									]}
								>
									{project.data.status}
								</span>
							</div>

							<p class="description">{project.data.description}</p>

							{project.data.technologies.length > 0 && (
								<div class="tech-tags">
									{project.data.technologies.map((tech) => (
										<span class="tech-chip">{tech}</span>
									))}
								</div>
							)}

							{project.data.github && (
								<div class="card-footer">
									<a
										href={project.data.github}
										target="_blank"
										rel="noopener noreferrer"
										class="github-link"
									>
										GitHub
										<span aria-hidden="true"> ↗</span>
									</a>
								</div>
							)}
						</article>
					))
				)
			}
		</div>
	</section>
</Layout>

<style>
	.page {
		max-width: var(--container-lg);
		margin: 0 auto;
		padding: var(--space-20) var(--space-6);
	}

	.intro {
		max-width: 700px;
		margin-bottom: var(--space-16);
	}

	.eyebrow {
		margin: 0 0 var(--space-3);
		font-size: var(--text-sm);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-muted);
	}

	h1 {
		margin: 0 0 var(--space-4);
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
	}

	.intro > p:last-child {
		margin: 0;
		font-size: var(--text-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-secondary);
	}

	/* ── Project list ── */
	.project-list {
		display: grid;
		gap: var(--space-6);
	}

	.project-card {
		padding: var(--space-8);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		transition: border-color var(--transition-base);
	}

	.project-card:hover {
		border-color: var(--color-border-strong);
	}

	.card-header {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		flex-wrap: wrap;
		margin-bottom: var(--space-3);
	}

	h2 {
		margin: 0;
		font-size: var(--text-xl);
		line-height: var(--leading-snug);
		color: var(--color-text);
	}

	/* ── Status badges ── */
	.badge {
		display: inline-block;
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		font-weight: 600;
		padding: 0.2rem 0.6rem;
		text-transform: capitalize;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.badge-active {
		background: var(--color-accent-subtle);
		color: var(--color-accent-dark);
	}

	.badge-completed {
		background: var(--color-border);
		color: var(--color-secondary);
	}

	.badge-experiment {
		background: var(--color-bg);
		color: var(--color-muted);
		border: 1px solid var(--color-border);
	}

	/* ── Description ── */
	.description {
		margin: 0 0 var(--space-4);
		line-height: var(--leading-relaxed);
		color: var(--color-secondary);
		max-width: 680px;
	}

	/* ── Technology chips ── */
	.tech-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-4);
	}

	.tech-chip {
		padding: 0.35rem 0.65rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		color: var(--color-secondary);
	}

	/* ── GitHub link ── */
	.card-footer {
		margin-top: var(--space-2);
	}

	.github-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--color-secondary);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.github-link:hover {
		color: var(--color-accent-dark);
	}

	.github-link:focus-visible {
		outline: 2px solid var(--color-accent-dark);
		outline-offset: 2px;
		border-radius: var(--radius-sm);
	}

	/* ── Empty state ── */
	.empty {
		padding: var(--space-12) 0;
		color: var(--color-muted);
		font-size: var(--text-lg);
	}

	/* ── Responsive ── */
	@media (max-width: 700px) {
		.page {
			padding: var(--space-12) var(--space-4);
		}

		.project-card {
			padding: var(--space-6);
		}
	}
</style>
